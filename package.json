{
  "name": "rpg-narrative-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A prose-first narrative game engine and Tauri editor for branching stories and text RPGs.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24.18.0 <27",
    "pnpm": "11.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:reference": "pnpm --filter @rpgnarrativeengine/showcase build",
    "check": "pnpm format:check && pnpm lint && pnpm policy && pnpm typecheck && pnpm test:all && pnpm build && pnpm build:reference && pnpm size && pnpm run licenses && pnpm run sbom",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "node scripts/dependency-inventory.mjs licenses",
    "lint": "eslint .",
    "policy": "pnpm policy:boundaries && pnpm policy:no-electron",
    "policy:boundaries": "node scripts/check-boundaries.mjs",
    "policy:no-electron": "node scripts/check-no-electron.mjs",
    "sbom": "node scripts/dependency-inventory.mjs sbom",
    "size": "node scripts/report-sizes.mjs",
    "test": "vitest run",
    "test:a11y": "vitest run tests/accessibility --passWithNoTests",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:a11y && pnpm test:determinism && pnpm test:conformance",
    "test:conformance": "vitest run tests/conformance --passWithNoTests",
    "test:determinism": "vitest run tests/determinism --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:unit": "vitest run tests/unit",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
