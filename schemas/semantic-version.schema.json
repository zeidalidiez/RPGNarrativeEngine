{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rpgnarrativeengine.dev/schemas/semantic-version.schema.json",
  "title": "RPG Narrative Engine semantic version",
  "description": "An exact Semantic Versioning 2.0.0 version without a prefix or surrounding range syntax.",
  "type": "string",
  "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
}
