{
  "name": "@rpgnarrativeengine/language",
  "version": "0.0.0",
  "private": true,
  "description": "RPG Narrative Engine language package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@lezer/common": "catalog:",
    "@lezer/lr": "catalog:"
  },
  "devDependencies": {
    "@lezer/generator": "catalog:"
  },
  "scripts": {
    "build": "pnpm run generate:parser && tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "generate:parser": "lezer-generator --typeScript --output src/story-parser.generated.ts src/story.grammar",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
