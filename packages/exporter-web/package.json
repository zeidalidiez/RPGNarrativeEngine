{
  "name": "@rpgnarrativeengine/exporter-web",
  "version": "0.0.0",
  "private": true,
  "description": "RPG Narrative Engine exporter-web package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@rpgnarrativeengine/ir": "workspace:*",
    "@rpgnarrativeengine/player": "workspace:*"
  },
  "devDependencies": {
    "vite": "8.1.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run generate:player && tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "generate:player": "node scripts/generate-web-player.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
