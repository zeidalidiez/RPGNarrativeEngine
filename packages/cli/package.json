{
  "name": "@rpgnarrativeengine/cli",
  "version": "0.0.0",
  "private": true,
  "description": "RPG Narrative Engine cli package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "bin": {
    "rpgne": "./dist/bin.js"
  },
  "dependencies": {
    "@rpgnarrativeengine/build": "workspace:*",
    "@rpgnarrativeengine/project": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "start": "node dist/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
